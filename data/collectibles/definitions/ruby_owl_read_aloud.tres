[resource]
script = ExtResource("1_definition")
id = "ruby_owl_read_aloud"
title = "Búho de Rubí"
category = "Lectura en voz alta"
content = "Los programas de texto a voz convierten las palabras escritas en audio. Esto permite escuchar un texto mientras se sigue la lectura en pantalla, lo que puede ayudar a reconocer palabras, comprender la información y estudiar con menos esfuerzo. Para algunas personas con dislexia, escuchar las palabras facilita el acceso a contenidos que les resultan difíciles de leer."
image = SubResource("AtlasTexture_ruby_owl")
