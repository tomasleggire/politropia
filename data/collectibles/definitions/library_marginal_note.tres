script = ExtResource("1_definition")
id = "library_marginal_note"
title = "Nota al margen"
category = "Historia"
content = "Texto provisional.

Una nota escrita con prisa en el borde de un libro. Alguien quería recordar una idea importante antes de que se le escapara. El equipo todavía debe definir su contenido final."
