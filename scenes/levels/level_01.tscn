[sub_resource type="Shader" id="Shader_gothic_grade"]
code = "shader_type canvas_item;\n\nvoid fragment() {\n\tvec2 centered = UV - vec2(0.5);\n\tfloat edge = smoothstep(0.30, 0.76, length(centered * vec2(1.0, 1.35)));\n\tfloat top_falloff = smoothstep(0.64, 0.0, UV.y) * 0.12;\n\tfloat bottom_haze = smoothstep(0.70, 1.0, UV.y) * 0.10;\n\tfloat alpha = min(0.58, edge * 0.46 + top_falloff + bottom_haze);\n\tCOLOR = vec4(0.006, 0.010, 0.035, alpha);\n}\n"

