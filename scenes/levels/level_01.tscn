[sub_resource type="Shader" id="Shader_gothic_grade"]
code = "shader_type canvas_item;

void fragment() {
	vec2 centered = UV - vec2(0.5);
	float edge = smoothstep(0.30, 0.76, length(centered * vec2(1.0, 1.35)));
	float top_falloff = smoothstep(0.64, 0.0, UV.y) * 0.12;
	float bottom_haze = smoothstep(0.70, 1.0, UV.y) * 0.10;
	float alpha = min(0.58, edge * 0.46 + top_falloff + bottom_haze);
	COLOR = vec4(0.006, 0.010, 0.035, alpha);
}
"

